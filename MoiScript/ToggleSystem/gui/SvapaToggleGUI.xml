<?xml version='1.0' encoding='utf-8'?>
<GUI onOpen="onOpen" onClose="onClose" onCreate="onCreate">
    <GuiElement profile="newLayer" />

    <GuiElement profile="svapaToggleRoot" id="toggleDialogElement">
        <Bitmap profile="svapaToggleOuter" id="toggleWindowOuter" />
        <Bitmap profile="svapaToggleInner" id="toggleWindowInner" />
        <Bitmap profile="svapaToggleListBg" id="toggleListBackground" />

        <GuiElement profile="svapaToggleListViewport" id="listViewport">
            <BoxLayout profile="svapaToggleListContainer" id="listContainer" />
            <Text profile="svapaToggleEmptyText" id="toggleEmptyText" text="Переключатели не найдены" />
        </GuiElement>

        <GuiElement profile="svapaToggleRowCard" id="rowTemplate">
            <Bitmap profile="svapaToggleRowBg" id="toggleRowBackground" />
            <Bitmap profile="svapaToggleDescriptionFrame" id="toggleDescriptionFrame" />
            <Text profile="svapaToggleDescriptionText" id="toggleDescriptionText" text="Описание переключателя" />

            <BinaryOption profile="svapaToggleBinaryOption" id="toggleBinaryOption">
                <Bitmap profile="svapaToggleBinaryBackground" name="background" id="toggleOptionBackground" />
                <Button profile="svapaToggleBinaryLeft" name="left" id="toggleOptionLeft" text="ВЫКЛ." />
                <Button profile="svapaToggleBinaryRight" name="right" id="toggleOptionRight" text="ВКЛ." />
                <Text profile="svapaToggleBinaryHiddenText" name="text" id="toggleOptionText" text="" />
                <Bitmap profile="svapaToggleBinarySlider" name="slider" id="toggleOptionSlider" />
            </BinaryOption>
        </GuiElement>

        <Text profile="svapaToggleFooterText" id="toggleFooterText" text="Измените переключатели и нажмите Сохранить" />
        <Button profile="svapaToggleBottomButtonSave" id="toggleSaveButton" text="Сохранить" onClick="onClickToggleSave" />
        <Button profile="svapaToggleBottomButtonClose" id="toggleCloseButton" text="Выйти" onClick="onClickToggleClose" />
        <Button profile="svapaTogglePrevPageButton" id="togglePrevPageButton" text="Назад" onClick="onClickPrevPage" />
        <Text profile="svapaTogglePageIndicatorText" id="togglePageIndicatorText" text="Страница 1 / 1" />
        <Button profile="svapaToggleNextPageButton" id="toggleNextPageButton" text="Вперёд" onClick="onClickNextPage" />
    </GuiElement>

    <GUIProfiles>
