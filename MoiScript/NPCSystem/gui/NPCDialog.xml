<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<Gui>
    <Dialog name="NPCDialogScreen" profile="dialogScreen" closeOnClickOutside="false" isCloseAllowed="true">
        <Frame profile="mainBox" width="900" height="620" arrangeMethod="vertical">
            <Text name="title" profile="textHeader" text="NPC" />

            <Frame profile="contentBox" width="100%" height="100%" arrangeMethod="horizontal">
                <Frame profile="portraitBox" width="220" height="100%" arrangeMethod="vertical">
                    <Text profile="textDefault" text="[Portrait Placeholder]" />
                </Frame>

                <Frame profile="dialogContent" width="680" height="100%" arrangeMethod="vertical">
                    <Text name="greeting" profile="textDefault" text="Greeting" />
                    <Text name="bodyText" profile="textDefault" text="Body" />
                    <Text name="description" profile="textDefault" text="Description" />

                    <Frame name="buttonList" profile="listBox" width="100%" height="230" arrangeMethod="vertical">
                        <Button name="actionButton1" profile="buttonDefault" text="Action 1" onClick="onClickAction" />
                        <Button name="actionButton2" profile="buttonDefault" text="Action 2" onClick="onClickAction" />
                        <Button name="actionButton3" profile="buttonDefault" text="Action 3" onClick="onClickAction" />
                    </Frame>

                    <Button name="closeButton" profile="buttonDefault" text="$l10n_button_back" onClick="onClickClose" />
                </Frame>
            </Frame>
        </Frame>
    </Dialog>
</Gui>
