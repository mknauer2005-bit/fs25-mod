<?xml version="1.0" encoding="utf-8"?>
<!--
    SvapaCropSeedOverride config
    - profile: SOWINGMACHINE / PLANTER
    - seedMode: fruits available when tank contains vanilla SEEDS
    - cropMode: fruits that can be loaded as real material (not converted to SEEDS)
    - rate: mandatory liters per square meter usage for each cropMode fruit
-->
<cropSeedOverride>
    <profiles>
        <profile name="SOWINGMACHINE">
            <seedMode fruits="GRASS OILSEEDRADISH SPINACH" />
            <cropMode>
                <fruit name="WHEAT" rate="0.020" />
                <fruit name="BARLEY" rate="0.020" />
                <fruit name="OAT" rate="0.022" />
                <fruit name="CANOLA" rate="0.009" />
                <fruit name="RICELONGGRAIN" rate="0.018" />
                <fruit name="PEA" rate="0.025" />
            </cropMode>
        </profile>

        <profile name="PLANTER">
            <seedMode fruits="SUGARBEET COTTON GREENBEAN" />
            <cropMode>
                <fruit name="MAIZE" rate="0.025" />
                <fruit name="SORGHUM" rate="0.024" />
                <fruit name="SUNFLOWER" rate="0.012" />
                <fruit name="SOYBEAN" rate="0.010" />
            </cropMode>
        </profile>
    </profiles>
</cropSeedOverride>
