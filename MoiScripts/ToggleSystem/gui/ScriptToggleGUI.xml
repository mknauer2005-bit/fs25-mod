<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<gui>
    <GuiElement type="ScreenElement" name="root" profile="mainScreen" focusChangeData="AUTO">
        <!-- Full-screen darkened background -->
        <GuiElement type="BitmapElement" name="backdrop" profile="settingsRow" position="0.5 0.5" size="1.0 1.0" color="0 0 0 0.7" />

        <!-- Main central panel (~90% screen) -->
        <GuiElement type="BoxLayoutElement" name="mainPanel" profile="settingsListContainer" position="0.5 0.5" size="0.9 0.88" flowDirection="vertical" elementSpacing="0.02" focusChangeData="TOP_BOTTOM" >
            <GuiElement type="TextElement" name="titleElement" profile="textHudTextTitle" text="ui_svapa_toggle_title" alignment="center" size="0.86 0.07" />

            <GuiElement type="ScrollingLayoutElement" name="listContainer" profile="settingsListContainer" size="0.86 0.69" flowDirection="vertical" numFlows="1" elementSpacing="0.014" clipping="true" focusChangeData="TOP_BOTTOM">
                <GuiElement type="BoxLayoutElement" name="rowTemplate" profile="settingsRow" size="0.84 0.12" flowDirection="horizontal" elementSpacing="0.02" focusChangeData="LEFT_RIGHT" >
                    <GuiElement type="CheckedOptionElement" name="toggleOption" profile="multiTextOption" size="0.19 0.075" />
                    <GuiElement type="TextElement" name="toggleDescription" profile="settingsValueText" size="0.60 0.09" text="-" wrap="true" />
                </GuiElement>
            </GuiElement>

            <GuiElement type="BoxLayoutElement" name="buttonsRow" profile="settingsRow" size="0.86 0.1" flowDirection="horizontal" elementSpacing="0.03" focusChangeData="LEFT_RIGHT" >
                <GuiElement type="ButtonElement" name="applyButton" profile="button" size="0.30 0.07" text="button_ok" onClick="onClickApply" />
                <GuiElement type="ButtonElement" name="exitButton" profile="button" size="0.30 0.07" text="button_back" onClick="onClickExit" />
            </GuiElement>
        </GuiElement>
    </GuiElement>
</gui>
