<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<upgrades>
    <!--
        sourceUniqueId = uniqueId старого preplaced объекта
        title          = название в окне (необязательно)
        description    = описание улучшения в окне
        price          = цена модернизации

        Каждый spawn = новый placeable, который будет поставлен после удаления старого.
        offsetX/Y/Z и rotOffsetX/Y/Z считаются от позиции и поворота старого объекта.
        uniqueId       = можно не указывать, тогда игра создаст новый автоматически.
    -->

    <upgrade
        sourceUniqueId="preplaced_Obnowa1"
        title="Новый комплекс"
        description="Современный коровник, рассчитанный на содержание до 5000 голов. Полностью оборудован для эффективного ведения хозяйства."
        price="150000">
        <spawn xmlFilename="map/placeables/Animals/cowBarn/StrojkaKorownik.xml"
            uniqueId="upgrade_Korownik_Construction"
            offsetX="0" offsetY="0" offsetZ="0"
            rotOffsetX="0" rotOffsetY="0" rotOffsetZ="0" />

        <spawn xmlFilename="map/placeables/Animals/cowBarn/cowBarn.xml"
            uniqueId="upgrade_Korownik_New"
            offsetX="0" offsetY="0" offsetZ="0"
            rotOffsetX="0" rotOffsetY="0" rotOffsetZ="0" />
		
		 <spawn xmlFilename="map/placeables/Animals/cowBarn/manureHeap.xml"
            uniqueId="upgrade_ManuerHep_New"
            offsetX="0" offsetY="0" offsetZ="0"
            rotOffsetX="0" rotOffsetY="0" rotOffsetZ="0" />
		
		<spawn xmlFilename="map/placeables/Animals/BunkerSilo/BunkerSilo.xml"
            uniqueId="upgrade_BunkerSilo_New"
            offsetX="-43.75" offsetY="0" offsetZ="23.321"
            rotOffsetX="0" rotOffsetY="60" rotOffsetZ="0" />
		<spawn xmlFilename="map/placeables/HranilichaTrawiKorownik/HranilichaTrawiKorownik.xml"
            uniqueId="upgrade_ManuerHep_New"
            offsetX="0" offsetY="0" offsetZ="0"
            rotOffsetX="0" rotOffsetY="0" rotOffsetZ="0" />
    </upgrade>

