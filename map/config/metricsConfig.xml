<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<metrics>
    <metric name="reputation" label="Репутация" trackSpent="true" roundDigits="0">
        <source type="state" key="workedHa" coefficient="1" />
        <source type="state" key="plowedHa" coefficient="1" />
        <source type="state" key="cultivatedHa" coefficient="1" />
        <source type="state" key="sownHa" coefficient="1" />
        <source type="state" key="sprayedHa" coefficient="1" />
        <source type="state" key="threshedHa" coefficient="1" />

        <source type="state" key="workedMinutes" coefficient="0.0333" />
        <source type="state" key="plowedMinutes" coefficient="0.0333" />
        <source type="state" key="cultivatedMinutes" coefficient="0.0333" />
        <source type="state" key="sownMinutes" coefficient="0.0333" />
        <source type="state" key="sprayedMinutes" coefficient="0.0333" />
        <source type="state" key="threshedMinutes" coefficient="0.0333" />

        <source type="state" key="seedUsage" coefficient="0.001" />
        <source type="state" key="sprayUsage" coefficient="0.001" />
        <source type="state" key="woodTonsSold" coefficient="1" />
        <source type="state" key="baleCount" coefficient="1" />
        <source type="state" key="wrappedBales" coefficient="1" />
        <source type="state" key="soldCottonBales" coefficient="1" />
        <source type="state" key="plantedTreeCount" coefficient="1" />
        <source type="state" key="cutTreeCount" coefficient="1" />
        <source type="state" key="traveledDistanceKm" coefficient="1" />
        <source type="state" key="fuelUsage" coefficient="0.001" />
        <source type="state" key="expenses" coefficient="0.001" />
        <source type="state" key="horseJumpCount" coefficient="1" />
        <source type="state" key="petDogCount" coefficient="1" />
        <source type="state" key="repairVehicleCount" coefficient="1" />

        <source type="soldFillType" fillType="ALL" coefficient="0.001" />
    </metric>
	<metric name="agro" label="Аграрий" trackSpent="true" roundDigits="0">
    <!-- Гектары -->
		<source type="state" key="workedHa" coefficient="1" />
		<source type="state" key="plowedHa" coefficient="1" />
		<source type="state" key="cultivatedHa" coefficient="1" />
		<source type="state" key="sownHa" coefficient="1" />
		<source type="state" key="sprayedHa" coefficient="1" />
		<source type="state" key="threshedHa" coefficient="1" />
	
		<!-- Время: 30 минут = 1 очко -->
		<source type="state" key="workedMinutes" coefficient="0.0333" />
		<source type="state" key="plowedMinutes" coefficient="0.0333" />
		<source type="state" key="cultivatedMinutes" coefficient="0.0333" />
		<source type="state" key="sownMinutes" coefficient="0.0333" />
		<source type="state" key="sprayedMinutes" coefficient="0.0333" />
		<source type="state" key="threshedMinutes" coefficient="0.0333" />
	
		<!-- Расход: 1000 литров = 1 очко -->
		<source type="state" key="seedUsage" coefficient="0.001" />
		<source type="state" key="sprayUsage" coefficient="0.001" />
	
		<!-- Дополнительно -->
		<source type="state" key="baleCount" coefficient="1" />
		<source type="state" key="wrappedBales" coefficient="1" />
		<!-- Продажа аграрных товаров -->
		<source type="soldFillType" fillType="FORAGE" coefficient="0.001" />
		<source type="soldFillType" fillType="PIGFOOD" coefficient="0.001" />
		<source type="soldFillType" fillType="SEEDS" coefficient="0.001" />
		<source type="soldFillType" fillType="FERTILIZER" coefficient="0.001" />
		<source type="soldFillType" fillType="LIQUIDFERTILIZER" coefficient="0.001" />
	</metric>
	<metric name="animal" label="Животновод" trackSpent="true" roundDigits="0">
		<!-- Молоко -->
		<source type="soldFillType" fillType="MILK" coefficient="0.001" />
		<source type="soldFillType" fillType="MILK_BOTTLED" coefficient="0.001" />
	
		<!-- Козье / буйволиное (если есть) -->
		<source type="soldFillType" fillType="GOATMILK" coefficient="0.001" />
		<source type="soldFillType" fillType="GOATMILK_BOTTLED" coefficient="0.001" />
		<source type="soldFillType" fillType="BUFFALOMILK" coefficient="0.001" />
		<source type="soldFillType" fillType="BUFFALOMILK_BOTTLED" coefficient="0.001" />
	
		<!-- Продукты -->
		<source type="soldFillType" fillType="CHEESE" coefficient="0.001" />
		<source type="soldFillType" fillType="BUTTER" coefficient="0.001" />
		<source type="soldFillType" fillType="GOATCHEESE" coefficient="0.001" />
		<source type="soldFillType" fillType="BUFFALOMOZZARELLA" coefficient="0.001" />
	
		<!-- Прочее -->
		<source type="soldFillType" fillType="EGG" coefficient="0.001" />
	</metric>
	<metric name="forestry" label="Лесник" trackSpent="true" roundDigits="0">
		<!-- Действия -->
		<source type="state" key="plantedTreeCount" coefficient="1" />
		<source type="state" key="cutTreeCount" coefficient="1" />
	
		<!-- Продажа древесины -->
		<source type="state" key="woodTonsSold" coefficient="1" />
	
		<!-- Продажа щепы -->
		<source type="soldFillType" fillType="WOODCHIPS" coefficient="0.001" />
		<source type="soldFillType" fillType="BOARDS" coefficient="0.001" />
		<source type="soldFillType" fillType="PLANKS" coefficient="0.001" />
		<source type="soldFillType" fillType="BARREL" coefficient="0.001" />
		<source type="soldFillType" fillType="EMPTYPALLET" coefficient="0.001" />
	</metric>
	<metric name="industry" label="Промышленник" trackSpent="true" roundDigits="0">
	
		<!-- Пищевая продукция -->
		<source type="soldFillType" fillType="BREAD" coefficient="0.001" />
		<source type="soldFillType" fillType="CAKE" coefficient="0.001" />
		<source type="soldFillType" fillType="BEER" coefficient="0.001" />
		<source type="soldFillType" fillType="GRAPEJUICE" coefficient="0.001" />
	
		<!-- Консервация -->
		<source type="soldFillType" fillType="JARRED_GREENBEAN" coefficient="0.001" />
		<source type="soldFillType" fillType="CANNED_PEAS" coefficient="0.001" />
		<source type="soldFillType" fillType="SPINACH_BAGS" coefficient="0.001" />
	
		<!-- Базовая переработка / сырьё предприятий -->
		<source type="soldFillType" fillType="SUGAR" coefficient="0.001" />
		<source type="soldFillType" fillType="CARTONROLL" coefficient="0.001" />
		<source type="soldFillType" fillType="PAPERROLL" coefficient="0.001" />
		<source type="soldFillType" fillType="BOARDS" coefficient="0.001" />
		<source type="soldFillType" fillType="PLANKS" coefficient="0.001" />
		<source type="soldFillType" fillType="BARREL" coefficient="0.001" />
		<source type="soldFillType" fillType="CANOLA_OIL" coefficient="0.001" />
		<source type="soldFillType" fillType="SUNFLOWER_OIL" coefficient="0.001" />
		<source type="soldFillType" fillType="RICE_OIL" coefficient="0.001" />
		<source type="soldFillType" fillType="OILSA" coefficient="0.001" />
		<source type="soldFillType" fillType="DIESEL" coefficient="0.001" />
		<source type="soldFillType" fillType="BAGS" coefficient="0.001" />

		<!-- Мукомолка / переработка -->
		<source type="soldFillType" fillType="FLOUR" coefficient="0.001" />
		<source type="soldFillType" fillType="RICEFLOUR" coefficient="0.001" />
	
		<!-- Строительство -->
		<source type="soldFillType" fillType="CEMENT" coefficient="0.001" />
		<source type="soldFillType" fillType="CEMENTBRICKS" coefficient="0.001" />
		<source type="soldFillType" fillType="ROOFPLATES" coefficient="0.001" />
	
		<!-- Деревообработка -->
		<source type="soldFillType" fillType="FURNITURE" coefficient="0.001" />
		<source type="soldFillType" fillType="LDSPBOARDS" coefficient="0.001" />
	
		<!-- Химия / производство -->
		<source type="soldFillType" fillType="DYES" coefficient="0.001" />
		<source type="soldFillType" fillType="GLUE" coefficient="0.001" />
		<source type="soldFillType" fillType="POLYMERS" coefficient="0.001" />
	
		<!-- Прочее производство -->
		<source type="soldFillType" fillType="CLOTHES" coefficient="0.001" />
	</metric>
</metrics>